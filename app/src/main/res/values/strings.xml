    <string name="help_wall">Photo wall</string>
    <string name="help_select">Select photos</string>
    <string name="help_select_text">Hold a photo to start selecting, then keep your finger down and slide across more. Hold a month’s heading to select the whole month.</string>
    <string name="help_tiles">Shortcuts above the wall</string>
    <string name="help_tiles_text">Choose up to three tiles to show above the photo wall: any folder you like, or Favourites, Front Row and Screenshots. Pick them in Settings › Photo wall shortcuts, then hold a tile and drag it to change the order.</string>
    <string name="help_viewing">Viewing a photo</string>
    <string name="help_switch">Its folder or the photo wall</string>
    <string name="help_switch_text">The button at the top switches between the photo’s own folder and the photo wall, staying on the same photo.</string>
    <string name="help_sending">Sending at full resolution</string>
    <string name="help_share">Send without compression</string>
    <string name="help_share_text">Share › “Share full-res img as file” sends the original photo, so it arrives at full resolution instead of as a compressed copy.</string>
    <string name="help_front_row">Front Row</string>
    <string name="help_front_row_text">Tap the Front Row button and the photo jumps to the front of the photo picker in any app you send photos from: chats, social media and the like. Photos you put there are collected in Images in Front Row.</string>
    <string name="help_tools">Tools</string>
    <string name="help_sort_text">Go through photos one at a time: swipe up to reject, swipe left to keep, or tap a folder at the bottom to move the photo there.</string>
    <string name="help_similar_text">Finds bursts and copies of the same picture. Tap photos to choose which to keep, then trash the rest.</string>
    <string name="help_compare_text">Pick two or more photos, from the toolbox or a selection’s ⋮ menu, and see them together. Zooming one zooms the other the same way.</string>
    <string name="help_open">Help</string>
