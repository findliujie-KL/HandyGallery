    <string name="tip_tools">Sort photos, find similar ones and compare them from here.</string>
    <string name="tip_shortcuts">Hold a tile and drag it to change the order.</string>
    <string name="tip_folder_order">Hold a folder and drag it to rearrange.</string>
    <string name="tip_switch">See this photo among its folder’s photos, or back on the photo wall.</string>
    <string name="tip_front_row">Front Row puts this photo first in the photo picker of messaging and social apps.</string>
    <string name="tip_save">Save changes the photo itself. You can still revert to the original later from the ⋮ menu.</string>
